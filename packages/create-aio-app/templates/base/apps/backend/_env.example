NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{dbName}}
DATABASE_SSL=false

# Comma-separated. Empty means "reflect any origin" (fine for local dev, set it for production).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-min-16-chars-access
JWT_REFRESH_SECRET=change-me-min-16-chars-refresh
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=2592000
